# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# See CLAUDE.md: this file (and .env) must never be printed or read back by the assistant.

# --- Safety-critical ---
# Leave both of these alone. Going live is a deliberate, multi-step process gated by
# docs/GO_LIVE_CHECKLIST.md, not a config edit.
LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

# --- Alpaca (paper keys from https://app.alpaca.markets/paper/dashboard/overview) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets
# iex (free) or sip (paid, Algo Trader Plus). See docs/PLAN.md for the bias this implies.
ALPACA_DATA_FEED=iex

# --- Interactive Brokers (IB Gateway or TWS must already be running and logged in) ---
# 127.0.0.1 only -- this codebase never connects to a remote Gateway.
IBKR_HOST=127.0.0.1
# 4002 = IB Gateway paper. 4001 (live) is only ever used by IBKRBroker.live(), which
# itself refuses to construct unless LIVE_TRADING=true above. TWS uses 7497/7496 instead
# of Gateway's 4002/4001 if you run TWS rather than the headless Gateway.
IBKR_PORT=4002
IBKR_LIVE_PORT=4001
# Must be unique per simultaneously-connected client against the same Gateway/TWS.
IBKR_CLIENT_ID=1

# --- Account ---
ACCOUNT_CURRENCY=GBP
STARTING_EQUITY_GBP=10000

# --- Storage ---
DATABASE_PATH=data/trading.db

# --- Alerting (optional; alerts are just skipped if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ---
DASHBOARD_PASSWORD=

# --- Go-live gate (docs/GO_LIVE_CHECKLIST.md, golive/gate.py) ---
# Hard ceiling on notional per live order once LIVE_TRADING is ever legitimately true.
# Never enforced in paper. See GOLIVE-006.
LIVE_EQUITY_CAP_GBP=3000
# A manually-updated approximation, not a live FX feed -- used only to convert the cap
# above into a USD notional cap. Update it periodically if GBP/USD moves a lot.
APPROX_GBP_USD_RATE=1.27
# Minimum paper-trading days and error-free lookback window the go-live gate requires.
GO_LIVE_MIN_PAPER_DAYS=30
GO_LIVE_MAX_ERRORS_LOOKBACK_DAYS=14

# --- Risk limits: override any RiskLimits field via RISK__<FIELD_NAME> if you ever need
# to change a default outside code review. Prefer changing config.py defaults instead so
# the change is reviewed and versioned. Example:
# RISK__MAX_TRADES_PER_DAY=5
