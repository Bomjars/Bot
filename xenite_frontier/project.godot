; Engine configuration file.
; Xenite Frontier - colony horde defence.

config_version=5

[application]

config/name="Xenite Frontier"
config/description="Contracted colonists defend remote mining outposts against a starving alien swarm."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/core/game_config.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
